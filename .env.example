# Google Agent Development Kit (ADK) Environment Configuration
# =============================================================

# Set this to 0 when using personal Google AI Studio API Keys (free/pay-as-you-go)
# Set this to 1 only when using Google Cloud Vertex AI Enterprise
GOOGLE_GENAI_USE_ENTERPRISE=0

# Your Google Gemini API Key from https://aistudio.google.com/app/apikey
# NOTE: One API key is shared across ALL agents, sub-agents, and tools!
GOOGLE_API_KEY=your_gemini_api_key_here

# (Optional) Override the Gemini model used by the agent
ADK_MODEL=gemini-2.5-flash
